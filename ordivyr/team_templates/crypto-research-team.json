          },
          {
            "provider": "claude",
            "model": ""
          },
          {
            "provider": "openai",
            "model": ""
          }
        ]
      },
      "limits": {
        "token_budget": 60000,
        "spend_cap_usd": 0.0,
        "max_seconds": 400,
        "concurrency": 1
      },
      "subagents": {
        "enabled": false,
        "max": 0
