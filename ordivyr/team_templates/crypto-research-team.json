{
  "schema": "ordivyr-template/1",
  "key": "crypto-research-team",
  "title": "Crypto Research Team",
  "tagline": "Research projects from every angle - research only.",
  "description": "A lead, an on-chain analyst, a market and sentiment analyst, a tokenomics analyst, a risk sceptic and an editor. It researches and reports. It has no wallets, keys or trading tools and gives no financial advice.",
  "tags": [
    "crypto",
    "research"
  ],
  "mission_hint": "Research Project X: team, token distribution, on-chain activity, market sentiment and the main risks. Produce a balanced brief.",
  "settings": {
    "max_depth": 3,
    "max_actions": 60,
    "max_drex_calls": 3
  },
  "events": [],
  "shared_memory": [
    "project-notes"
  ],
  "departments": [
    {
      "key": "analysis",
      "name": "Analysis desk",
      "x": 30,
      "y": 190,
      "w": 760,
      "h": 140,
      "policy": {
        "tools_deny": [],
        "max_autonomy": "supervised"
      }
    }
  ],
  "agents": [
    {
      "key": "lead",
      "name": "Research Lead",
      "role": "Frames the question, owns the brief",
      "x": 330,
      "y": 20,
      "dept": null,
      "soul": "Balanced, evidence-first.",
      "instructions": "Split the project into on-chain, market, tokenomics and risk questions. Research only: never recommend buying or selling.",
