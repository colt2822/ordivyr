      "memory": {
        "private": true,
        "shared": [
          "project-notes"
        ],
        "mode": "readwrite"
      },
      "license": {
        "autonomy": "supervised",
        "paid_allowed": true
      },
      "gambits": [
        {
          "name": "Research goes to On-chain",
          "if": {
            "kind": "task_type",
            "value": "research"
          },
          "then": {
            "kind": "delegate",
            "target": "@onchain"
          }
        },
        {
          "name": "Review goes to Risk",
          "if": {
            "kind": "task_type",
            "value": "qa"
          },
          "then": {
            "kind": "delegate",
            "target": "@risk"
          }
        },
        {
          "name": "Nobody fits? Ask DREX",
          "if": {
            "kind": "no_worker"
          },
          "then": {
            "kind": "ask_drex",
            "target": ""
          }
        }
      ]
    },
