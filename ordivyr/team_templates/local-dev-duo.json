      "tools": [
        "file_write"
      ],
      "permissions": "workspace-write",
      "model": {
        "tier": "fast",
        "suggest": [],
        "role": "coder"
      },
      "limits": {
        "token_budget": 60000,
        "max_seconds": 600
      },
      "memory": {
        "private": true,
        "shared": [
          "project"
        ],
        "mode": "readwrite"
      },
      "license": {
        "skills": [
          "coding"
        ],
        "gpu": false,
        "autonomy": "supervised",
        "paid_allowed": false
      }
    }
  ],
  "bridges": [
    {
      "from": "planner",
      "to": "coder",
      "kind": "both"
