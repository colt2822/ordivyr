{
  "schema": "ordivyr-template/1",
  "key": "youtube-production-team",
  "title": "YouTube Production Team",
  "tagline": "From idea to upload-ready package.",
  "description": "An executive producer, a topic scout, a scriptwriter, a title and thumbnail strategist, an edit planner and a publishing checker. Nothing is uploaded; you publish.",
  "tags": [
    "video",
    "content"
  ],
  "mission_hint": "Plan next week's video: 'How solar chargers actually work' - topic, script, titles, thumbnail ideas and edit plan.",
  "settings": {
    "max_depth": 3,
    "max_actions": 50,
    "max_drex_calls": 3
  },
  "events": [],
  "shared_memory": [
    "channel-brand"
  ],
  "departments": [],
  "agents": [
    {
      "key": "producer",
      "name": "Executive Producer",
      "role": "Owns the video from idea to package",
      "x": 330,
      "y": 20,
      "dept": null,
      "soul": "Energetic, audience-first.",
      "instructions": "Decide the angle, then route scouting, scripting, packaging and the edit plan. Keep the channel voice consistent.",
