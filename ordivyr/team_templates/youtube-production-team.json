        "media"
      ],
      "tools": [
        "browser"
      ],
      "mcp": [],
      "permissions": "read-only",
      "model": {
        "tier": "strong",
        "suggest": [
          {
            "provider": "anthropic",
            "model": "claude-opus-5-5"
          },
          {
            "provider": "claude",
            "model": ""
          },
          {
            "provider": "openai",
            "model": ""
          }
        ]
      },
      "limits": {
        "token_budget": 60000,
        "spend_cap_usd": 0.0,
        "max_seconds": 400,
        "concurrency": 1
      },
      "subagents": {
        "enabled": false,
        "max": 0
      },
      "memory": {
        "private": true,
        "shared": [
          "channel-brand"
        ],
        "mode": "readwrite"
      },
      "license": {
        "autonomy": "supervised",
        "paid_allowed": true
      },
      "gambits": [
        {
          "name": "Research goes to Topic Scout",
          "if": {
            "kind": "task_type",
            "value": "research"
          },
          "then": {
            "kind": "delegate",
            "target": "@scout"
          }
        },
        {
          "name": "Media goes to Scriptwriter",
          "if": {
            "kind": "task_type",
            "value": "media"
          },
          "then": {
            "kind": "delegate",
            "target": "@writer"
          }
        },
        {
          "name": "Nobody fits? Ask DREX",
          "if": {
            "kind": "no_worker"
          },
          "then": {
            "kind": "ask_drex",
            "target": ""
          }
        }
      ]
    },
