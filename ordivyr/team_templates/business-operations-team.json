{
  "schema": "ordivyr-template/1",
  "key": "business-operations-team",
  "title": "Business Operations Team",
  "tagline": "Keep the small business running.",
  "description": "An operations lead with an inbox and calendar assistant, a bookkeeper, a support agent, a sales-outreach drafter and a weekly reporter. Customer-facing agents can only draft; you press send.",
