      "x": 30,
      "y": 190,
      "w": 760,
      "h": 140,
      "policy": {
        "tools_deny": [
          "shell",
          "code_exec"
        ],
        "max_autonomy": "supervised",
        "paid_allowed": false
      }
    }
  ],
