        "private": true,
        "shared": [
          "business-facts"
        ],
        "mode": "readwrite"
      },
      "license": {
        "autonomy": "supervised",
        "paid_allowed": true
      },
      "gambits": [
        {
          "name": "Outreach goes to Sales",
          "if": {
            "kind": "task_type",
            "value": "outreach"
          },
          "then": {
            "kind": "delegate",
            "target": "@sales"
          }
        },
        {
          "name": "Research goes to Reporter",
          "if": {
            "kind": "task_type",
            "value": "research"
          },
          "then": {
            "kind": "delegate",
            "target": "@reporter"
          }
        },
        {
          "name": "Nobody fits? Ask DREX",
          "if": {
            "kind": "no_worker"
          },
          "then": {
            "kind": "ask_drex",
            "target": ""
          }
        }
      ]
    },
