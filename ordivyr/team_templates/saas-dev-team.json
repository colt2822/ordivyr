          },
          {
            "provider": "claude",
            "model": ""
          },
          {
            "provider": "openai",
            "model": ""
          }
        ]
      },
      "limits": {
        "token_budget": 60000,
        "spend_cap_usd": 0.0,
        "max_seconds": 400,
        "concurrency": 1
      },
      "subagents": {
        "enabled": false,
        "max": 0
      },
      "memory": {
        "private": true,
        "shared": [
          "product-spec"
        ],
        "mode": "readwrite"
      },
      "license": {
        "autonomy": "supervised",
        "paid_allowed": true
      },
      "gambits": [
        {
          "name": "Code goes to Backend",
          "if": {
            "kind": "task_type",
            "value": "coding"
          },
          "then": {
            "kind": "delegate",
            "target": "@backend"
          }
        },
        {
          "name": "Research goes to Architect",
          "if": {
            "kind": "task_type",
            "value": "research"
          },
          "then": {
            "kind": "delegate",
            "target": "@architect"
          }
        },
        {
          "name": "Reviews go to QA",
          "if": {
            "kind": "task_type",
            "value": "qa"
          },
          "then": {
            "kind": "delegate",
            "target": "@qa"
          }
        },
        {
          "name": "Nobody fits? Ask DREX",
          "if": {
            "kind": "no_worker"
          },
          "then": {
            "kind": "ask_drex",
            "target": ""
          }
        }
      ]
    },
