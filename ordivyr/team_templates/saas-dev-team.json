{
  "schema": "ordivyr-template/1",
  "key": "saas-dev-team",
  "title": "SaaS Development Team",
  "tagline": "Ship features from spec to release.",
  "description": "A product lead who plans, an architect, front-end and back-end builders, a QA engineer and a release manager. Nothing ships without QA and your sign-off.",
  "tags": [
    "software",
    "product"
  ],
  "mission_hint": "Build and ship: a password-reset flow with email verification.",
  "settings": {
    "max_depth": 3,
    "max_actions": 50,
    "max_drex_calls": 3
  },
  "events": [
    "release-approved"
  ],
  "shared_memory": [
    "product-spec"
  ],
  "departments": [
    {
      "key": "eng",
      "name": "Engineering",
      "x": 40,
      "y": 190,
      "w": 760,
      "h": 340,
      "policy": {
        "max_autonomy": "supervised"
      }
    }
  ],
  "agents": [
    {
      "key": "lead",
      "name": "Product Lead",
      "role": "Plans the work and routes it",
      "x": 330,
      "y": 20,
      "dept": null,
      "soul": "Calm, decisive, plain-spoken.",
      "instructions": "Turn the mission into small tickets. Route each ticket to the right builder. Never write code yourself. Summarise progress.",
